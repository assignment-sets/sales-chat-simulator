GROQ_API_KEY=<REDACTED>
GROQ_MODEL=<REDACTED>
NEXT_PUBLIC_SUPABASE_URL=<REDACTED>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<REDACTED>
JEV_API_KEY=<REDACTED>

# --- Rate limiting (Upstash Redis) -----------------------------------------
UPSTASH_REDIS_REST_URL=<REDACTED>
UPSTASH_REDIS_REST_TOKEN=<REDACTED>
# Vercel Marketplace uses these names instead (auto-injected on deploy):
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token

# Set to "true" to bypass rate limiting entirely (e.g. local load tests).
RATE_LIMIT_DISABLED=<REDACTED>

# Set to "true" to bypass the read-through cache (see docs/CACHING.md).
CACHE_DISABLED=<REDACTED>

